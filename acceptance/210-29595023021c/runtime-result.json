     "evidence": {
      "head_host_default_llama_and_whisper": "real host cache names CUDA 13; product withheld; child mapped the system /usr/local/cuda-13.1 objects",
      "head_system_precedence_host": "same withhold, child mapped the system objects",
      "head_synthetic_multiarch_populated": "no readable cache and the arch dir holds the pair: helper answered 'already provides' and the product withheld",
      "head_synthetic_multiarch_emptied": "same shape with the dir emptied: helper answered 'not provided', product appended, and the loader used the vendored dir",
